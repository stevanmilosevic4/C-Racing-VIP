# Backend (optional) — copy to .env.local for local dev, and add the same
# two vars in Vercel → Project → Settings → Environment Variables for prod.
# Without these, the app runs on localStorage only (single-device).
#
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
