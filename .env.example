# Backend (optional) — copy to .env.local for local dev, and add the same
# two vars in Vercel → Project → Settings → Environment Variables for prod.
# Without these, the app runs on localStorage only (single-device).
#
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Email sign-in codes are sent by /api/send-code via Resend, from
# a2rl@weareconstructor.com. Set RESEND_API_KEY in Vercel (Settings ->
# Environment Variables, Production) - it is a SERVER-side secret, no
# VITE_ prefix. While unset, guests sign in without email verification.
# RESEND_API_KEY=re_xxxxxxxx (Vercel only - do not put real keys in this file)
